# 源码统一 LF，避免 Windows 检出时把构建脚本转成 CRLF
*.py    text eol=lf
*.js    text eol=lf
*.java  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf

# 二进制资源不做任何转换
*.png   binary
*.mp3   binary
*.apk   binary
*.jpg   binary
